{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://zamp-ps1-backend-production.up.railway.app/v1/:path*" },
    { "source": "/((?!v1/|assets/).*)", "destination": "/index.html" }
  ]
}
